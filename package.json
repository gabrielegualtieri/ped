{
  "name": "@gabrielegualtieri/ped",
  "version": "0.1.2",
  "description": "Ped: run the open-source Jev-compatible System-1 decision model (convaiinnovations/laya) from Node.js / TypeScript via ONNX Runtime",
  "license": "MIT",
  "author": "Gabriele Gualtieri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielegualtieri/ped.git"
  },
  "homepage": "https://github.com/gabrielegualtieri/ped#readme",
  "bugs": {
    "url": "https://github.com/gabrielegualtieri/ped/issues"
  },
  "keywords": [
    "ped",
    "jev",
    "system-one",
    "decision-model",
    "onnx",
    "onnxruntime",
    "modernbert",
    "classification"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit",
    "test": "tsx --test test/test_download.ts test/test_model.ts test/test_sequence.ts",
    "format": "prettier --write \"{src,test,examples}/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,test,examples}/**/*.ts\" \"*.{json,md}\"",
    "example": "tsx examples/basic.ts",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "onnxruntime-node": "^1.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24.0.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-sonarjs": "^4",
    "globals": "^17",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8"
  }
}
